<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Có thể đổi Data Source tại đây nếu máy không có LocalDB, ví dụ: .\SQLEXPRESS -->
    <add name="CoffeeDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QuanLyQuanCaPheT1;Integrated Security=True;MultipleActiveResultSets=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
